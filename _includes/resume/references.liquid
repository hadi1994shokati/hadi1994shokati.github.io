<div class="references-section">
  {% for ref in data[1] %}
    <div class="reference-item mb-4">
      <div class="reference-header">
        {% if ref.icon %}
          <i class="{{ ref.icon }} mr-2"></i>
        {% endif %}
        <h4 class="d-inline">{{ ref.name }}</h4>
      </div>
      <div class="reference-body ml-4">
        <p class="mb-1"><strong>{{ ref.title }}</strong></p>
        <p class="mb-1">{{ ref.department }}</p>
        <p class="mb-1">{{ ref.institution }}</p>
        {% if ref.role %}
          <p class="mb-2">{{ ref.role }}</p>
        {% endif %}
        <div class="reference-links">
          {% if ref.url %}
            <a href="{{ ref.url }}" target="_blank" class="btn btn-sm btn-outline-primary mr-2">
              <i class="fas fa-external-link-alt mr-1"></i>Faculty Profile
            </a>
          {% endif %}
          {% if ref.email %}
            <a href="mailto:{{ ref.email }}" class="btn btn-sm btn-outline-primary">
              <i class="fas fa-envelope mr-1"></i>Email
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}
</div>

<style>
.references-section {
  margin-top: 1rem;
}
.reference-item {
  border-left: 3px solid #007bff;
  padding-left: 1rem;
}
.reference-header {
  margin-bottom: 0.5rem;
}
.reference-body {
  color: #666;
}
.reference-body p {
  margin-bottom: 0.25rem;
}
.reference-links {
  margin-top: 0.75rem;
}
.btn-outline-primary {
  border-color: #007bff;
  color: #007bff;
}
.btn-outline-primary:hover {
  background-color: #007bff;
  color: white;
}
</style>
